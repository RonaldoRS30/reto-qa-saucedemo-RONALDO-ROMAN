{
  "name": "reto-qa-saucedemo",
  "version": "1.0.0",
  "description": "Suite de pruebas automatizadas de Sauce Demo con Playwright, Cucumber y TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js --config=config/cucumber.js",
    "test:login": "npm test -- --tags @login",
    "test:smoke": "npm test -- --tags @smoke",
    "test:login-exitoso": "npm test -- --tags @login_exitoso",
    "test:login-invalid": "npm test -- --tags @login_credenciales_invalidas",
    "test:login-bloqueado": "npm test -- --tags @login_usuario_bloqueado",
    "test:carrito": "npm test -- --tags @carrito",
    "test:carrito-agregar": "npm test -- --tags @carrito_agregar_producto",
    "test:carrito-visualizar": "npm test -- --tags @carrito_visualizar_productos",
    "test:carrito-eliminar": "npm test -- --tags @carrito_eliminar_producto",
    "test:checkout": "npm test -- --tags @checkout",
    "test:checkout-exitoso": "npm test -- --tags @checkout_exitoso",
    "test:checkout-error": "npm test -- --tags @checkout_datos_incompletos"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "dotenv": "^18.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
