{
  "name": "reto-qa-saucedemo",
  "version": "1.0.0",
  "description": "Suite de pruebas automatizadas de Sauce Demo con Playwright, Cucumber y TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js --config=config/cucumber.js",
    "test:smoke": "npm test -- --tags @smoke",
    "test:regresion": "npm test -- --tags @regresion",
    "test:login": "npm test -- --tags @login",
    "test:carrito": "npm test -- --tags @carrito",
    "test:checkout": "npm test -- --tags @checkout",
    "test:positivo": "npm test -- --tags @positivo",
    "test:negativo": "npm test -- --tags @negativo",
    "allure-generate": "allure generate allure-results --clean -o allure-report",
    "allure-open": "allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.14.0",
    "dotenv": "^18.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
